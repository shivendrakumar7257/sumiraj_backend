PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# Authentication JWT Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Vercel Blob Storage Token (For image & PDF uploads in production)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxx

# SMTP / Email Configuration (Provider used to send emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sending_email@gmail.com
SMTP_PASS=your_app_password

# Sender Details (Displayed in the "From" header of received emails)
MAIL_FROM_NAME=Sumiraj
MAIL_FROM_ADDRESS=info@sumiraj.com

# Recipient Email for Incoming Inquiries (Where form submissions will be received)
INQUIRY_NOTIFICATION_EMAIL=info@sumiraj.com
QUOTE_NOTIFICATION_EMAIL=info@sumiraj.com

# Backend URL (Used to resolve full image/attachment links in notification emails)
BACKEND_URL=http://localhost:5000

# CORS / Frontend Domain Configuration
FRONTEND_URL=https://sumiraj.com
CORS_ORIGIN=https://sumiraj.com,https://www.sumiraj.com,http://localhost:5173,http://localhost:3000
